{
  "spec_version": 2,
  "name": "modecanada_mnl",
  "description": "ModeCanada MNL: generic time (in-vehicle + out-of-vehicle) and cost, ASCs (car is the reference).",
  "model": "MNL",
  "alternatives": [
    "train",
    "car",
    "bus",
    "air"
  ],
  "parameters": {
    "ASC_TRAIN": {
      "start": 0
    },
    "ASC_BUS": {
      "start": 0
    },
    "ASC_AIR": {
      "start": 0
    },
    "B_COST": {
      "start": 0
    },
    "B_TIME": {
      "start": 0
    }
  },
  "utilities": {
    "train": "ASC_TRAIN + B_COST * train_cost + B_TIME * train_time",
    "car": "B_COST * car_cost + B_TIME * car_time",
    "bus": "ASC_BUS + B_COST * bus_cost + B_TIME * bus_time",
    "air": "ASC_AIR + B_COST * air_cost + B_TIME * air_time"
  }
}
