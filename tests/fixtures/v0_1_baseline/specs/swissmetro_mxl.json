{
  "spec_version": 2,
  "name": "swissmetro_mxl",
  "description": "0.1.x Swissmetro MXL, normal time coefficient; 0.1.x used 100 pseudo-random draws (not the 200 it set).",
  "model": "MXL",
  "alternatives": [
    "train",
    "sm",
    "car"
  ],
  "parameters": {
    "ASC_TRAIN": {
      "start": 0
    },
    "ASC_CAR": {
      "start": 0
    },
    "B_TIME": {
      "start": 0
    },
    "B_COST": {
      "start": 0
    },
    "B_TIME_S": {
      "start": 1
    }
  },
  "utilities": {
    "train": "ASC_TRAIN + B_TIME_RND * TRAIN_TT / 100 + B_COST * TRAIN_CO * (GA == 0) / 100",
    "sm": "B_TIME_RND * SM_TT / 100 + B_COST * SM_CO * (GA == 0) / 100",
    "car": "ASC_CAR + B_TIME_RND * CAR_TT / 100 + B_COST * CAR_CO / 100"
  },
  "random_parameters": {
    "B_TIME_RND": {
      "distribution": "normal",
      "mean": "B_TIME",
      "spread": "B_TIME_S"
    }
  },
  "draws": {
    "number": 100,
    "seed": 42,
    "type": "pseudo",
    "panel": false
  }
}
