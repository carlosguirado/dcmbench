{
  "spec_version": 2,
  "name": "modecanada_mxl",
  "description": "0.1.x ModeCanada MXL, negative lognormal time coefficient; 100 pseudo-random draws.",
  "model": "MXL",
  "alternatives": [
    "train",
    "car",
    "bus",
    "air"
  ],
  "parameters": {
    "ASC_TRAIN": {
      "start": 0
    },
    "ASC_BUS": {
      "start": 0
    },
    "ASC_AIR": {
      "start": 0
    },
    "B_COST": {
      "start": 0
    },
    "B_TIME": {
      "start": -3
    },
    "B_TIME_S": {
      "start": 1
    }
  },
  "utilities": {
    "train": "ASC_TRAIN + B_COST * train_cost + B_TIME_RND * train_time",
    "car": "B_COST * car_cost + B_TIME_RND * car_time",
    "bus": "ASC_BUS + B_COST * bus_cost + B_TIME_RND * bus_time",
    "air": "ASC_AIR + B_COST * air_cost + B_TIME_RND * air_time"
  },
  "random_parameters": {
    "B_TIME_RND": {
      "distribution": "lognormal",
      "mean": "B_TIME",
      "spread": "B_TIME_S",
      "sign": -1
    }
  },
  "draws": {
    "number": 100,
    "seed": 42,
    "type": "pseudo",
    "panel": false
  }
}
